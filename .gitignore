# Personal learning data - DO NOT commit
/data/*.json
/data/*.json.backup-*
/results/*.md
# Except the README files which explain the structure
!/data/README.md
!/results/README.md

# Personal writing/practice files
myfile.txt

# Backup files created by hooks
.backups/

# Keep directory structure but ignore contents
!/data/.gitkeep
!/results/.gitkeep

# System files
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temp files
.tmp/
temp/
*.json.tmp

# Agent scratch payloads (rewritten every session; old ones live in .tmp/legacy-payloads/)
.claude/tmp_*
.claude/temp/

# Claude Code local settings — machine-specific permissions, never shared
.claude/settings.local.json

# A Windows `2>nul` redirect writes a real file, and git cannot check that name out again
nul

